<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <mirror>
      <id>cic-ext-pull-through</id>
      <name>Maven Central</name>
      <url>https://artifacts.hyland.dev/basic/cic-ext-pull-through/maven/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

  <servers>
    <!-- Exported by the cloudsmith-auth action -->
    <server>
      <id>cic-ext-pull-through</id>
      <username>${env.CLOUDSMITH_USERNAME}</username>
      <password>${env.CLOUDSMITH_API_KEY}</password>
    </server>
    <server>
      <id>alfresco-private-repository</id>
      <username>${env.CLOUDSMITH_USERNAME}</username>
      <password>${env.CLOUDSMITH_API_KEY}</password>
    </server>
    <server>
      <id>activiti-private-repository</id>
      <username>${env.CLOUDSMITH_USERNAME}</username>
      <password>${env.CLOUDSMITH_API_KEY}</password>
    </server>
    <server>
      <id>alfresco-releases</id>
      <username>${env.CLOUDSMITH_USERNAME}</username>
      <password>${env.CLOUDSMITH_API_KEY}</password>
    </server>
    <server>
      <id>central</id>
      <username>${MAVEN_CENTRAL_USERNAME}</username>
      <password>${MAVEN_CENTRAL_PASSWORD}</password>
    </server>
    <server>
      <id>central-releases-staging</id>
      <username>${env.MAVEN_CENTRAL_USERNAME}</username>
      <password>${env.MAVEN_CENTRAL_PASSWORD}</password>
    </server>
    <server>
      <id>alfresco-internal</id>
      <username>${env.CLOUDSMITH_USERNAME}</username>
      <password>${env.CLOUDSMITH_API_KEY}</password>
    </server>
  </servers>

  <!-- CI only: ACS enterprise alpha artifacts (e.g. org.alfresco:acs-packaging:26.3.0-A.34) are published
       to the internal repository, not to alfresco-private. Needed by the enterprise-*-tests profiles
       when they target an ACS alpha. Kept out of pom.xml so published SDK POMs don't reference it. -->
  <profiles>
    <profile>
      <id>alfresco-internal</id>
      <repositories>
        <repository>
          <id>alfresco-internal</id>
          <url>https://artifacts.hyland.dev/basic/alfresco-internal/maven/</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>alfresco-internal</activeProfile>
  </activeProfiles>
</settings>
